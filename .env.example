# ==============================================================================
# BRIGHTLOOP SOFTWARE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. APPLICATION & SERVER
PORT=3000
NODE_ENV=development
JWT_SECRET=brightloop-hackathon-super-secret-jwt-key-min-32-chars

# 2. LOCAL PERSISTENCE (Default: Zero setup required)
DATABASE_PATH=./subscriptions.db

# 3. SUPABASE / POSTGRESQL (Optional: For live cloud deployment & remote Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 4. EMAIL PROVIDER (Optional: For actual production email delivery)
# RESEND_API_KEY=re_123456789
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxx

# 5. PAYMENT GATEWAY (Optional: For automated gateway webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
